# ═══════════════════════════════════════════════════════════
# ATSHEL HSE Manager — Variables de Entorno
# ═══════════════════════════════════════════════════════════
#
# INSTRUCCIONES:
# 1. Copiá este archivo: cp .env.example .env.local
# 2. Completá los valores reales en .env.local
# 3. NUNCA commitees .env.local al repo (ya está en .gitignore)
# 4. En Vercel: Settings → Environment Variables → agregar cada una
#
# REGLA DE ORO:
#   VITE_* → pública, va al bundle del frontend → solo anon key
#   Sin VITE_ → privada, solo disponible en Edge Functions → service_role
#
# ═══════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────
# URL del proyecto (pública, no es un secreto)
VITE_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co

# Clave ANON (pública — RLS la protege)
# Nunca la confundas con la service_role key
VITE_SUPABASE_ANON_KEY=eyJhbGc...tu_anon_key_aqui

# ── PowerSync ────────────────────────────────────────────────
# URL de tu instancia PowerSync Cloud
VITE_POWERSYNC_URL=https://TU_INSTANCIA.powersync.journeyapps.com

# ── App ──────────────────────────────────────────────────────
# Entorno (development | staging | production)
VITE_APP_ENV=development

# Versión de la app (se muestra en el footer y los logs)
VITE_APP_VERSION=1.0.0

# ═══════════════════════════════════════════════════════════
# VARIABLES PRIVADAS (solo para Edge Functions — NO tienen prefijo VITE_)
# Configurar directamente en Supabase Dashboard → Settings → Secrets
# ═══════════════════════════════════════════════════════════

# Clave de servicio — NUNCA en el frontend
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...NUNCA_AQUI

# ═══════════════════════════════════════════════════════════
# VERIFICACIÓN: cómo saber si están bien configuradas
#
# En la consola del browser debería aparecer:
#   [ATSHEL] Supabase auth cargado ✓
#   [ATSHEL] Core cargado ✓
#
# Si aparece un error de "anon key no configurada",
# las variables de entorno no están llegando al build.
# ═══════════════════════════════════════════════════════════
