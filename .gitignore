.env.local
.env.*.local
.env.production

# ── Dependencias ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build de Vite ─────────────────────────────────────────────
dist/
dist-ssr/
*.local

# ── Editores ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Supabase local ────────────────────────────────────────────
supabase/.temp/
supabase/config.toml.local

# ── Archivos temporales de análisis ──────────────────────────
