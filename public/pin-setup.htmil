<!DOCTYPE html>
<html lang="es" dir="ltr">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<meta name="theme-color" content="#1C1C1E">
	<meta name="description" content="ATSHEL HSE Manager — Configurar PIN">
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
	<title>ATSHEL — Configurar PIN</title>
	<link rel="manifest" href="/manifest.json">
	<link rel="stylesheet" href="/css/atshel-theme.css">
	<style>
		body {
			display: flex;
			flex-direction: column;
			min-height: 100dvh;
			background: var(--color-bg);
		}

		/* ── Header ── */
		.pin-header {
			position: sticky;
			top: 0;
			z-index: 10;
			background: var(--color-surface);
			border-bottom: 1px solid var(--color-border);
			padding: var(--s4);
			display: flex;
			align-items: center;
			gap: var(--s3);
		}

		.pin-header__logo {
			width: 32px;
			height: 32px;
			background: var(--color-yellow);
			border-radius: var(--radius-sm);
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
		}

		.pin-header__logo svg {
			width: 20px;
			height: 20px;
			color: var(--color-bg);
		}

		.pin-header__title {
			font-family: var(--font-display);
			font-size: var(--text-lg);
			font-weight: 700;
			color: var(--color-text);
			line-height: 1;
		}

		/* ── Main ── */
		.pin-main {
			flex: 1;
			display: flex;
			flex-direction: column;
			align-items: center;
			padding: var(--s6) var(--s4);
			gap: var(--s6);
			max-width: 400px;
			width: 100%;
			margin: 0 auto;
		}

		/* ── Aviso firma ── */
		.firma-badge {
			width: 100%;
			display: flex;
			gap: var(--s3);
			padding: var(--s4);
			background: var(--color-yellow-dim);
			border: 1px solid var(--color-yellow);
			border-radius: var(--radius);
		}

		.firma-badge__icon {
			font-size: 28px;
			flex-shrink: 0;
			line-height: 1;
		}

		.firma-badge__text {}

		.firma-badge__title {
			font-family: var(--font-display);
			font-size: var(--text-base);
			font-weight: 700;
			color: var(--color-yellow);
			margin-bottom: var(--s1);
		}

		.firma-badge__body {
			font-size: var(--text-xs);
			color: var(--color-text-muted);
			line-height: 1.5;
		}

		/* ── Vistas ── */
		.pin-view         { display: none; width: 100%; }
		.pin-view--active { display: flex; flex-direction: column; align-items: center; gap: var(--s5); width: 100%; }

		/* ── Título de vista ── */
		.view-title {
			font-family: var(--font-display);
			font-size: var(--text-2xl);
			font-weight: 700;
			color: var(--color-text);
			text-align: center;
		}

		.view-sub {
			font-size: var(--text-sm);
			color: var(--color-text-muted);
			text-align: center;
			line-height: 1.5;
			margin-top: calc(-1 * var(--s3));
		}

		/* ── Puntos de PIN ── */
		.pin-dots {
			display: flex;
			gap: var(--s3);
			justify-content: center;
			align-items: center;
			min-height: 32px;
		}

		.pin-dot {
			width: 18px;
			height: 18px;
			border-radius: 50%;
			border: 2px solid var(--color-border);
			background: transparent;
			transition: background var(--transition), border-color var(--transition), transform 0.1s ease;
		}

		.pin-dot--filled {
			background: var(--color-yellow);
			border-color: var(--color-yellow);
			transform: scale(1.1);
		}

		.pin-dot--error {
			background: var(--color-red);
			border-color: var(--color-red);
			animation: shake 0.3s ease;
		}

		.pin-dot--success {
			background: var(--color-green);
			border-color: var(--color-green);
		}

		@keyframes shake {
			0%, 100% { transform: translateX(0); }
			20%       { transform: translateX(-6px); }
			40%       { transform: translateX(6px); }
			60%       { transform: translateX(-4px); }
			80%       { transform: translateX(4px); }
		}

		/* ── Input numérico oculto ── */
		.pin-input-hidden {
			position: absolute;
			opacity: 0;
			pointer-events: none;
			width: 1px;
			height: 1px;
		}

		/* ── Teclado numérico ── */
		.pin-keyboard {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: var(--s3);
			width: 100%;
			max-width: 320px;
		}

		.pin-key {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			min-height: 72px;
			border-radius: var(--radius);
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			font-family: var(--font-display);
			font-size: var(--text-2xl);
			font-weight: 700;
			color: var(--color-text);
			cursor: pointer;
			transition: background var(--transition), border-color var(--transition), transform 0.08s ease;
			user-select: none;
			-webkit-user-select: none;
			/* Target táctil mínimo 72px — más que suficiente */
		}

		.pin-key:active,
		.pin-key--pressed {
			background: var(--color-surface-2);
			border-color: var(--color-yellow);
			transform: scale(0.96);
		}

		.pin-key--empty {
			background: transparent;
			border-color: transparent;
			cursor: default;
			pointer-events: none;
		}

		.pin-key__sub {
			font-size: 9px;
			font-weight: 500;
			color: var(--color-text-muted);
			letter-spacing: 0.06em;
			line-height: 1;
			margin-top: 2px;
		}

		.pin-key--delete {
			font-size: var(--text-xl);
			color: var(--color-text-muted);
		}

		.pin-key--delete svg {
			width: 28px;
			height: 28px;
		}

		/* ── Alerta ── */
		.alert {
			width: 100%;
			display: none;
			padding: var(--s3) var(--s4);
			border-radius: var(--radius-sm);
			font-size: var(--text-sm);
			font-weight: 500;
			line-height: 1.4;
			text-align: center;
		}

		.alert--error   { background: var(--color-red-dim);   color: var(--color-red);   border: 1px solid var(--color-red); }
		.alert--success { background: var(--color-green-dim); color: var(--color-green); border: 1px solid var(--color-green); }
		.alert--visible { display: block; }

		/* ── Vista de éxito ── */
		.success-icon {
			width: 80px;
			height: 80px;
			background: var(--color-green-dim);
			border: 2px solid var(--color-green);
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.success-icon svg {
			width: 40px;
			height: 40px;
			color: var(--color-green);
		}

		/* ── Vista completado (obrero ya tiene PIN) ── */
		.completado-icon {
			width: 80px;
			height: 80px;
			background: var(--color-yellow-dim);
			border: 2px solid var(--color-yellow);
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 40px;
		}

		/* ── Footer ── */
		.pin-footer {
			padding: var(--s4);
			padding-bottom: calc(var(--s4) + env(safe-area-inset-bottom, 0px));
			max-width: 400px;
			width: 100%;
			margin: 0 auto;
		}

		/* Loading */
		.btn--loading {
			opacity: 0.65;
			pointer-events: none;
		}
	</style>
</head>
<body>

<!-- ── Header ──────────────────────────────────────────── -->
<header class="pin-header" role="banner">
	<div class="pin-header__logo" aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<path d="M12 2C8 2 4 5.5 4 10v1h16v-1c0-4.5-4-8-8-8z"/>
			<rect x="2" y="11" width="20" height="3" rx="1"/>
			<line x1="7" y1="18" x2="17" y2="18"/>
			<line x1="9" y1="21" x2="15" y2="21"/>
		</svg>
	</div>
	<h1 class="pin-header__title">Configurar PIN</h1>
</header>

<!-- ── Main ────────────────────────────────────────────── -->
<main class="pin-main" id="pin-main">

	<!-- Aviso firma legal -->
	<div class="firma-badge" role="note">
		<span class="firma-badge__icon" aria-hidden="true">🔐</span>
		<div class="firma-badge__text">
			<p class="firma-badge__title">Tu PIN = Tu firma legal</p>
			<p class="firma-badge__body">
				Este PIN de 6 dígitos es tu firma digital. Nunca lo compartás.
				Cada documento que firmés con él tiene validez legal.
			</p>
		</div>
	</div>

	<div id="alert-pin" class="alert" role="alert" aria-live="assertive"></div>

	<!-- ══ VISTA 1: Ingresar PIN ══════════════════════════ -->
	<div id="view-ingresar" class="pin-view pin-view--active" aria-label="Elegí tu PIN">

		<p class="view-title">Elegí tu PIN</p>
		<p class="view-sub">6 dígitos. No uses fechas de nacimiento ni secuencias obvias.</p>

		<!-- Puntos visuales -->
		<div class="pin-dots" id="dots-ingresar" aria-hidden="true">
			<div class="pin-dot" data-index="0"></div>
			<div class="pin-dot" data-index="1"></div>
			<div class="pin-dot" data-index="2"></div>
			<div class="pin-dot" data-index="3"></div>
			<div class="pin-dot" data-index="4"></div>
			<div class="pin-dot" data-index="5"></div>
		</div>

		<!-- Input oculto accesible -->
		<input
			type="tel"
			id="inp-pin"
			class="pin-input-hidden"
			inputmode="numeric"
			pattern="[0-9]*"
			maxlength="6"
			autocomplete="off"
			aria-label="PIN de 6 dígitos"
			aria-required="true"
		>

		<!-- Teclado numérico -->
		<div class="pin-keyboard" id="kbd-ingresar" role="group" aria-label="Teclado numérico">
			<button type="button" class="pin-key" data-digit="1" aria-label="1">1<span class="pin-key__sub"></span></button>
			<button type="button" class="pin-key" data-digit="2" aria-label="2 ABC">2<span class="pin-key__sub">ABC</span></button>
			<button type="button" class="pin-key" data-digit="3" aria-label="3 DEF">3<span class="pin-key__sub">DEF</span></button>
			<button type="button" class="pin-key" data-digit="4" aria-label="4 GHI">4<span class="pin-key__sub">GHI</span></button>
			<button type="button" class="pin-key" data-digit="5" aria-label="5 JKL">5<span class="pin-key__sub">JKL</span></button>
			<button type="button" class="pin-key" data-digit="6" aria-label="6 MNO">6<span class="pin-key__sub">MNO</span></button>
			<button type="button" class="pin-key" data-digit="7" aria-label="7 PQRS">7<span class="pin-key__sub">PQRS</span></button>
			<button type="button" class="pin-key" data-digit="8" aria-label="8 TUV">8<span class="pin-key__sub">TUV</span></button>
			<button type="button" class="pin-key" data-digit="9" aria-label="9 WXYZ">9<span class="pin-key__sub">WXYZ</span></button>
			<div class="pin-key pin-key--empty" aria-hidden="true"></div>
			<button type="button" class="pin-key" data-digit="0" aria-label="0">0</button>
			<button type="button" class="pin-key pin-key--delete" id="btn-delete-1" aria-label="Borrar último dígito">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/>
					<line x1="18" y1="9" x2="12" y2="15"/>
					<line x1="12" y1="9" x2="18" y2="15"/>
				</svg>
			</button>
		</div>

	</div>

	<!-- ══ VISTA 2: Confirmar PIN ═════════════════════════ -->
	<div id="view-confirmar" class="pin-view" aria-label="Confirmá tu PIN">

		<p class="view-title">Confirmá tu PIN</p>
		<p class="view-sub">Ingresá nuevamente los 6 dígitos para confirmar.</p>

		<div class="pin-dots" id="dots-confirmar" aria-hidden="true">
			<div class="pin-dot" data-index="0"></div>
			<div class="pin-dot" data-index="1"></div>
			<div class="pin-dot" data-index="2"></div>
			<div class="pin-dot" data-index="3"></div>
			<div class="pin-dot" data-index="4"></div>
			<div class="pin-dot" data-index="5"></div>
		</div>

		<input
			type="tel"
			id="inp-pin-confirm"
			class="pin-input-hidden"
			inputmode="numeric"
			pattern="[0-9]*"
			maxlength="6"
			autocomplete="off"
			aria-label="Confirmación del PIN de 6 dígitos"
			aria-required="true"
		>

		<div class="pin-keyboard" id="kbd-confirmar" role="group" aria-label="Teclado numérico de confirmación">
			<button type="button" class="pin-key" data-digit="1" aria-label="1">1<span class="pin-key__sub"></span></button>
			<button type="button" class="pin-key" data-digit="2" aria-label="2 ABC">2<span class="pin-key__sub">ABC</span></button>
			<button type="button" class="pin-key" data-digit="3" aria-label="3 DEF">3<span class="pin-key__sub">DEF</span></button>
			<button type="button" class="pin-key" data-digit="4" aria-label="4 GHI">4<span class="pin-key__sub">GHI</span></button>
			<button type="button" class="pin-key" data-digit="5" aria-label="5 JKL">5<span class="pin-key__sub">JKL</span></button>
			<button type="button" class="pin-key" data-digit="6" aria-label="6 MNO">6<span class="pin-key__sub">MNO</span></button>
			<button type="button" class="pin-key" data-digit="7" aria-label="7 PQRS">7<span class="pin-key__sub">PQRS</span></button>
			<button type="button" class="pin-key" data-digit="8" aria-label="8 TUV">8<span class="pin-key__sub">TUV</span></button>
			<button type="button" class="pin-key" data-digit="9" aria-label="9 WXYZ">9<span class="pin-key__sub">WXYZ</span></button>
			<div class="pin-key pin-key--empty" aria-hidden="true"></div>
			<button type="button" class="pin-key" data-digit="0" aria-label="0">0</button>
			<button type="button" class="pin-key pin-key--delete" id="btn-delete-2" aria-label="Borrar último dígito">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/>
					<line x1="18" y1="9" x2="12" y2="15"/>
					<line x1="12" y1="9" x2="18" y2="15"/>
				</svg>
			</button>
		</div>

	</div>

	<!-- ══ VISTA 3: Éxito ════════════════════════════════ -->
	<div id="view-exito" class="pin-view" aria-label="PIN configurado correctamente">

		<div class="success-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="20 6 9 17 4 12"/>
			</svg>
		</div>

		<p class="view-title">PIN configurado</p>
		<p class="view-sub">
			Tu firma digital está lista.<br>
			Guardala en un lugar seguro y nunca la compartás.
		</p>

	</div>

	<!-- ══ VISTA 4: Obrero completado ════════════════════ -->
	<div id="view-completado" class="pin-view" aria-label="Proceso completado">

		<div class="completado-icon" aria-hidden="true">✅</div>

		<p class="view-title">¡Listo!</p>
		<p class="view-sub">
			Aceptaste los términos y configuraste tu PIN.<br>
			El administrador de tu empresa ya tiene acceso a tus registros.
		</p>

	</div>

</main>

<!-- ── Footer ──────────────────────────────────────────── -->
<footer class="pin-footer" id="pin-footer" style="display:none;">
	<button
		type="button"
		class="btn btn--primary btn--full"
		id="btn-continuar"
	>
		Ir al inicio
	</button>
</footer>

<!-- Scripts -->
<script>
	window.__ATSHEL_CONFIG = {
		supabaseUrl: 'https://elhweuwczmcatypphnco.supabase.co',
		supabaseKey: 'sb_publishable_IjVdETBNeNBzUnIs13aPlw_RwU-DQo-'
	};
</script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.4.9/dist/purify.min.js"></script>
<script src="/js/atshel-supabase.js"></script>

<script>
/* ──────────────────────────────────────────────────────────
   pin-setup.js — Configuración de PIN ATSHEL

   Flujo:
   1. Verificar sesión → si no hay, redirigir a login
   2. Verificar si ya tiene PIN → si sí y es obrero → vista completado
   3. Si ?completado=1 en URL → mostrar vista completado directo
   4. Vista 1: elegir PIN (6 dígitos, teclado custom)
   5. Vista 2: confirmar PIN (comparar con el primero)
   6. Si coinciden: llamar fn_guardar_pin + actualizar user_metadata
   7. Vista 3: éxito → redirigir según rol

   Reglas:
   - Event listeners SOLO en init()
   - PIN nunca se guarda en texto plano en el cliente
   - PIN se borra de memoria apenas se envía al servidor
   - Teclado numérico custom (no teclado del sistema)
   ────────────────────────────────────────────────────────── */

(function PinSetupModule() {
	'use strict';

	/* ── Estado ─────────────────────────────────────────── */
	let _pin1        = '';   /* PIN ingresado en vista 1 */
	let _pin2        = '';   /* PIN de confirmación */
	let _currentUser = null;
	let _vistaActual = 'ingresar';

	/* ── DOM ─────────────────────────────────────────────── */
	const $ = id => document.getElementById(id);

	/* ── Vistas ──────────────────────────────────────────── */
	function showView(name) {
		['ingresar','confirmar','exito','completado'].forEach(v => {
			const el = $('view-' + v);
			if (el) el.classList.toggle('pin-view--active', v === name);
		});
		_vistaActual = name;

		/* Mostrar footer solo en éxito y completado */
		const footer = $('pin-footer');
		if (footer) {
			footer.style.display = ['exito','completado'].includes(name) ? 'block' : 'none';
		}
	}

	/* ── Puntos visuales ─────────────────────────────────── */
	function actualizarPuntos(containerId, pinActual, estado) {
		const container = $(containerId);
		if (!container) return;
		const dots = container.querySelectorAll('.pin-dot');
		dots.forEach((dot, i) => {
			dot.className = 'pin-dot';
			if (estado === 'error') {
				dot.classList.add('pin-dot--error');
			} else if (estado === 'success') {
				dot.classList.add('pin-dot--success');
			} else if (i < pinActual.length) {
				dot.classList.add('pin-dot--filled');
			}
		});
	}

	/* ── Alertas ──────────────────────────────────────────── */
	function showAlert(msg, type) {
		const el = $('alert-pin');
		if (!el) return;
		el.textContent = msg;
		el.className = 'alert alert--' + (type || 'error') + ' alert--visible';
	}

	function hideAlert() {
		const el = $('alert-pin');
		if (!el) return;
		el.textContent = '';
		el.className = 'alert';
	}

	/* ── Validar PIN ─────────────────────────────────────── */
	function esPinDebil(pin) {
		/* Rechazar secuencias obvias */
		const secuencias = ['123456','234567','345678','456789','012345',
		                    '111111','222222','333333','444444','555555',
		                    '666666','777777','888888','999999','000000'];
		return secuencias.includes(pin);
	}

	/* ── Lógica de ingreso de dígito ─────────────────────── */
	function ingresarDigito(digit) {
		hideAlert();

		if (_vistaActual === 'ingresar') {
			if (_pin1.length >= 6) return;
			_pin1 += digit;
			actualizarPuntos('dots-ingresar', _pin1, null);

			if (_pin1.length === 6) {
				/* Validar PIN débil */
				if (esPinDebil(_pin1)) {
					actualizarPuntos('dots-ingresar', _pin1, 'error');
					showAlert('Este PIN es muy fácil de adivinar. Elegí uno más seguro.');
					setTimeout(() => {
						_pin1 = '';
						actualizarPuntos('dots-ingresar', _pin1, null);
						hideAlert();
					}, 1200);
					return;
				}
				/* Pasar a confirmación */
				setTimeout(() => {
					_pin2 = '';
					actualizarPuntos('dots-confirmar', _pin2, null);
					showView('confirmar');
				}, 200);
			}

		} else if (_vistaActual === 'confirmar') {
			if (_pin2.length >= 6) return;
			_pin2 += digit;
			actualizarPuntos('dots-confirmar', _pin2, null);

			if (_pin2.length === 6) {
				setTimeout(() => verificarYGuardar(), 150);
			}
		}
	}

	function borrarDigito() {
		hideAlert();
		if (_vistaActual === 'ingresar' && _pin1.length > 0) {
			_pin1 = _pin1.slice(0, -1);
			actualizarPuntos('dots-ingresar', _pin1, null);
		} else if (_vistaActual === 'confirmar' && _pin2.length > 0) {
			_pin2 = _pin2.slice(0, -1);
			actualizarPuntos('dots-confirmar', _pin2, null);
		}
	}

	/* ── Verificar y guardar PIN ─────────────────────────── */
	async function verificarYGuardar() {
		if (_pin1 !== _pin2) {
			/* PINs no coinciden */
			actualizarPuntos('dots-confirmar', _pin2, 'error');
			showAlert('Los PINs no coinciden. Intentá de nuevo.');
			setTimeout(() => {
				_pin1 = '';
				_pin2 = '';
				actualizarPuntos('dots-ingresar', _pin1, null);
				actualizarPuntos('dots-confirmar', _pin2, null);
				hideAlert();
				showView('ingresar');
			}, 1200);
			return;
		}

		/* PINs coinciden — guardar */
		actualizarPuntos('dots-confirmar', _pin2, 'success');

		try {
			/* Llamar a fn_guardar_pin en Supabase */
			const { error } = await window.ATSHEL_AUTH.rpc('fn_guardar_pin', {
				p_pin: _pin1
			});

			/* Borrar PIN de memoria inmediatamente */
			_pin1 = '';
			_pin2 = '';

			if (error) {
				actualizarPuntos('dots-confirmar', '', 'error');
				showAlert('No se pudo guardar el PIN: ' + error.message);
				setTimeout(() => {
					actualizarPuntos('dots-ingresar', '', null);
					actualizarPuntos('dots-confirmar', '', null);
					hideAlert();
					showView('ingresar');
				}, 2000);
				return;
			}

			/* Actualizar user_metadata para marcar PIN configurado */
			await window.ATSHEL_AUTH.updateUserMeta({
				pin_configurado: true
			});

			/* Mostrar éxito */
			showView('exito');

		} catch (err) {
			_pin1 = '';
			_pin2 = '';
			console.error('[PIN] Error guardando PIN:', err);
			showAlert('Sin conexión. Verificá tu red e intentá de nuevo.');
			setTimeout(() => {
				actualizarPuntos('dots-ingresar', '', null);
				hideAlert();
				showView('ingresar');
			}, 2000);
		}
	}

	/* ── Destino post-PIN según rol ──────────────────────── */
	function redirigirSegunRol() {
		const rol    = _currentUser?.app_metadata?.rol;
		const oficio = _currentUser?.app_metadata?.oficio;

		if (!rol && oficio) {
			/* Obrero: mostrar vista completado */
			showView('completado');
			return;
		}

		/* Admin / supervisor / hse → dashboard */
		window.location.replace('/index.html');
	}

	/* ── Init teclado ────────────────────────────────────── */
	function initTeclado(kbdId, deleteId) {
		const kbd = $(kbdId);
		if (!kbd) return;

		/* Dígitos */
		kbd.querySelectorAll('.pin-key[data-digit]').forEach(btn => {
			btn.addEventListener('click', () => {
				const digit = btn.getAttribute('data-digit');
				if (digit !== null) ingresarDigito(digit);
			});

			/* Efecto visual de press */
			btn.addEventListener('pointerdown', () => btn.classList.add('pin-key--pressed'));
			btn.addEventListener('pointerup',   () => btn.classList.remove('pin-key--pressed'));
			btn.addEventListener('pointerleave',() => btn.classList.remove('pin-key--pressed'));
		});

		/* Borrar */
		const delBtn = $(deleteId);
		if (delBtn) {
			delBtn.addEventListener('click', borrarDigito);
		}
	}

	/* ── Init ────────────────────────────────────────────── */
	async function init() {

		/* 1. Verificar sesión */
		try {
			const session = await window.ATSHEL_AUTH.getSession();
			if (!session?.user) {
				window.location.replace('/login.html');
				return;
			}
			_currentUser = session.user;
		} catch (err) {
			window.location.replace('/login.html');
			return;
		}

		/* 2. Si viene de ?completado=1 → obrero ya terminó */
		const params = new URLSearchParams(window.location.search);
		if (params.get('completado') === '1') {
			showView('completado');
			return;
		}

		/* 3. Si ya tiene PIN configurado */
		if (_currentUser.user_metadata?.pin_configurado) {
			const rol    = _currentUser?.app_metadata?.rol;
			const oficio = _currentUser?.app_metadata?.oficio;

			if (!rol && oficio) {
				showView('completado');
			} else {
				window.location.replace('/index.html');
			}
			return;
		}

		/* 4. Verificar que aceptó términos */
		if (!_currentUser.user_metadata?.terminos_aceptado_en) {
			window.location.replace('/terminos.html');
			return;
		}

		/* 5. Iniciar teclados */
		initTeclado('kbd-ingresar', 'btn-delete-1');
		initTeclado('kbd-confirmar', 'btn-delete-2');

		/* 6. Botón continuar (vista éxito/completado) */
		const btnContinuar = $('btn-continuar');
		if (btnContinuar) {
			btnContinuar.addEventListener('click', redirigirSegunRol);
		}

		/* 7. Soporte teclado físico (para testing en desktop) */
		document.addEventListener('keydown', (e) => {
			if (_vistaActual === 'exito' || _vistaActual === 'completado') return;
			if (e.key >= '0' && e.key <= '9') ingresarDigito(e.key);
			if (e.key === 'Backspace') borrarDigito();
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}

})();
</script>

</body>
</html>
